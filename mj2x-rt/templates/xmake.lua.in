set_project("@PROJECT_NAME@")
set_version("0.1.0")
set_languages("c99", "cxx17")
add_rules("mode.debug", "mode.release")

target("mj2x_native")
    set_kind("shared")
    set_targetdir("$(projectdir)/build/$(plat)/$(arch)/$(mode)")
    if os.isfile("src/generated/native.c") then
        if is_plat("windows") then
            add_files("src/generated/native.c", {cxflags = "/TC"})
        else
            add_files("src/generated/native.c")
        end
    end
    if os.isfile("src/generated/native.cpp") then
        add_files("src/generated/native.cpp")
    end
    if is_plat("windows") then
        add_files("src/mj2x-rt/**.c", {cxflags = "/TC"})
    else
        add_files("src/mj2x-rt/**.c")
    end
    if #os.files("src/mj2x-rt/**.cpp") > 0 then
        add_files("src/mj2x-rt/**.cpp")
    end
    add_includedirs("src/mj2x-rt")
@RT_BACKEND_DEFINES@
    local jdk_path = os.getenv("JAVA_HOME")
    if jdk_path then
        add_includedirs(jdk_path .. "/include")
        if is_plat("windows") then
            add_includedirs(jdk_path .. "/include/win32")
            add_linkdirs(jdk_path .. "/lib")
        elseif is_plat("linux") then
            add_includedirs(jdk_path .. "/include/linux")
            add_linkdirs(jdk_path .. "/lib/server")
        elseif is_plat("macosx") then
            add_includedirs(jdk_path .. "/include/darwin")
        end
    else
        print("warning: JAVA_HOME is not set; JNI headers are required to build mj2x_native")
    end

    if is_plat("windows") then
        add_cflags("/utf-8", {tools = "cl"})
        add_cxxflags("/utf-8", {tools = "cl"})
        -- 生成码与 mj2x-rt 跨 TU：热路径 JNI 薄包装（如 enum values 站点、
        -- 字段缓存读写）在 generated TU 与 runtime TU 间调用，跨 TU 内联
        -- 需要全程序优化。仅 cl 生效（/GL + /LTCG，tools 守卫），mingw/gcc 不受影响。
        add_cxflags("/GL", {tools = "cl"})
        add_ldflags("/LTCG", {tools = "link"})
    else
        add_syslinks("pthread", "m")
    end
