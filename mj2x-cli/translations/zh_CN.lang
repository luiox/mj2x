mj2x.cli.help.dump_template_flag=--dump-config-template [<file>] 输出带注释的配置模板到文件或 stdout
mj2x.cli.help.lang_flag=--lang <lang>|界面语言(zh_CN / en_US;亦可用 MJ2X_LANG 环境变量)
mj2x.cli.help.help_flag=--help|打印帮助

